      "clientTesting": "Reject assumptions. Demand alignment with the client's historical data or stated pains."
    }
  },

  "outputRequirements": {
    "sections": [
      "Viability Verdict (Green/Yellow/Red)",
      "Risk Audit",
      "Operational Gaps",
      "Required Fixes"
