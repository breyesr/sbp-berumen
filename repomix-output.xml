CREATE TABLE IF NOT EXISTS "persona_intelligence" (
    "persona_id" INTEGER PRIMARY KEY REFERENCES "personas"("id") ON DELETE CASCADE,
    "metadata" JSONB NOT NULL, -- Stores goals, pains, channels, etc.
