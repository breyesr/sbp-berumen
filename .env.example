# Upstash Redis (for Rate Limiting)
# Get these from https://console.upstash.com/
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Local Docker database
POSTGRES_URL_LOCAL="postgresql://user:password@localhost:5433/persona_db"

# Vercel/production database (set in Vercel, optional locally)
POSTGRES_URL=""

# Optional: Number of connections in the pool (default: 10 in prod, 1 in dev)
POSTGRES_MAX_CONNECTIONS=10

# OpenAI API
OPENAI_API_KEY=""

# Auth.js / NextAuth
AUTH_SECRET=""

# Optional: override the chat model
OPENAI_MODEL="gpt-4o-mini"
